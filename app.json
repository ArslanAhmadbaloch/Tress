{
  "expo": {
    "name": "Tress",
    "slug": "tress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tress",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6F3",
    "ios": {
      "bundleIdentifier": "com.tress.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tress.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0E9E3",
          "image": "./assets/images/splash-plate.jpg",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#F0E9E3",
            "image": "./assets/images/splash-plate.jpg",
            "resizeMode": "cover"
          },
          "enableFullScreenImage_legacy": true,
          "android": {
            "backgroundColor": "#F0E9E3"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tress uses the camera to take the photographs you keep in your journal and to read product barcodes. Photographs are saved on this device and never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Tress uses motion to tell when your phone is steady, so it can take the photo for you."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tress uses Face ID to unlock your journey."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tress uses a photo of you on your journey card. It stays on this device."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "react-native-fast-tflite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "primaryColor": "#2F8E78",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1c02635-1f03-4d45-93d6-a3431f748730"
      }
    },
    "owner": "arslanbaloch1"
  }
}
