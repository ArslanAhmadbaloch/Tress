{
  "expo": {
    "name": "My Hair Journey",
    "slug": "hair-journey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hairjourney",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6F3",
    "ios": {
      "bundleIdentifier": "com.hairjourney.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hairjourney.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0E9E3",
          "image": "./assets/images/splash-plate.jpg",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#F0E9E3",
            "image": "./assets/images/splash-plate.jpg",
            "resizeMode": "cover"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hair Journey uses the camera to take your progress photos. They are saved on this device and never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hair Journey uses Face ID to unlock your journey."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hair Journey uses a photo of you on your journey card. It stays on this device."
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "primaryColor": "#2F8E78"
  }
}
